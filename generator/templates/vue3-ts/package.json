{
  "name": "vue3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run type-check && vp build",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "test": "vp test run",
    "test:unit": "vp test",
    "lint": "vp lint && eslint . --cache",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "spell": "cspell \"**/*.{js,ts,mjs,cjs,json,css,less,scss,vue,html,md}\"",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.1.0",
    "@vueuse/router": "^14.1.0",
    "axios": "^1.13.2",
    "colord": "^2.9.3",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.0",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.4",
    "v-scale-screen": "^2.3.0",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^20.3.1",
    "@iconify-json/ep": "^1.2.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@unocss/eslint-config": "^66.5.12",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.1",
    "cspell": "^9.6.0",
    "cz-git": "^1.12.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.2.7",
    "sass-embedded": "^1.97.3",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "typescript": "~6.0.0",
    "unocss": "^66.5.12",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-compression2": "^2.4.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-restart": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plus": "1.4.0",
    "vue-tsc": "^3.2.6"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.17.0"
}
