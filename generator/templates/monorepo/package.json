{
  "name": "@starter/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --filter @starter/web^... build && vp run @starter/web#dev",
    "admin:dev": "vp run --filter @starter/admin^... build && vp run @starter/admin#dev",
    "dev:shared": "vp run --filter @starter/web^... build && vp run --parallel @starter/ui#dev @starter/utils#dev @starter/web#dev",
    "build": "vp run -r build",
    "type-check": "vp run type-check:config && vp run -r type-check",
    "test": "vp run -r test",
    "lint": "vp lint",
    "stylelint": "stylelint \"{apps,packages}/**/src/**/*.{vue,css,scss}\"",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test:e2e": "playwright test",
    "commit": "git-cz",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "release:tag": "changeset tag",
    "lint:fix": "vp lint --fix",
    "stylelint:fix": "vp run stylelint --fix",
    "staged": "vp staged --concurrent 2 --relative",
    "hooks:install": "vp hooks enable",
    "hooks:status": "vp hooks status",
    "commit:check": "vp exec commitlint",
    "test:watch": "vp run --parallel -r test:watch",
    "verify:hooks": "node scripts/verify-hooks.mjs",
    "check": "vp run build:dependencies && vp check",
    "check:fix": "vp run build:dependencies && vp check --fix",
    "build:dependencies": "vp run --filter \"./packages/*\" build",
    "audit": "vp pm audit",
    "deps:outdated": "vp pm outdated",
    "deps:approve": "vp pm approve-builds",
    "audit:official": "vp pm audit -- --registry=https://registry.npmjs.org",
    "artifacts:check": "node scripts/check-artifacts.mjs",
    "release:archive": "vp run build && node scripts/archive.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vue/tsconfig": "catalog:",
    "commitizen": "catalog:",
    "cz-git": "catalog:",
    "postcss-html": "catalog:",
    "postcss-scss": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-recommended": "catalog:",
    "stylelint-config-recommended-scss": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.17.0"
}
